# Copy this file to .env and fill in your values.
#
# One DRIVE_<letter> entry per host drive you want Add Project to be able to
# browse and manage. Each is bind-mounted read/write into the backend
# container, so it gives the container full access to that drive - only do
# this on a trusted single-user machine.
#
# Only define the drives that actually exist on your machine (check with
# `Get-PSDrive -PSProvider FileSystem` in PowerShell). If a path doesn't
# exist, `docker compose up` will fail to mount it.
#
# Network-mapped drives (net use) are not always visible to Docker Desktop -
# if one fails to mount, remove its line and the matching volume entry in
# docker-compose.yml.
DRIVE_C=C:\
DRIVE_D=D:\
